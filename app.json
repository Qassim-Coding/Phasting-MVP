{
  "expo": {
    "name": "Phasting",
    "slug": "phasting",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "phasting",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.phasting.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C2E26",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "./plugins/withPhastingTheme",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2F6F1"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Elapsed",
              "label": "Phasting · Temps de jeûne",
              "description": "Ton temps de jeûne et ta phase en cours",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Detail",
              "label": "Phasting · Détail",
              "description": "Ta phase, ce que fait ton corps et l'accès direct à « J'ai envie de craquer »",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "982229a7-1b49-4cae-b1b2-1cceb69a8897"
      }
    },
    "owner": "qassim-coding"
  }
}
